# Dependencies and package-manager caches
/node_modules/
/.pnp/
.pnp.*
/.npm/
/.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output and framework caches
/dist/
/out/
/.next/
/.vinext/
/.vite/
/.turbo/
/.cache/
/.eslintcache
*.tsbuildinfo
next-env.d.ts
vite.config.*.timestamp-*

# Test and coverage output
/coverage/
/test-results/
/playwright-report/
/blob-report/
/.pytest_cache/
/.coverage
/htmlcov/
**/__pycache__/
*.py[cod]

# Local environment and secrets
.env*
!.env.example
!.env.sample
*.pem
/.dev.vars*

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp
*.temp
*~
/tmp/
/temp/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
/.idea/
/.vscode/
/.history/
*.swp
*.swo

# Local deployment state
/.vercel/
/.wrangler/
/.cloudflare/

# Checkout-local agent, preview, and generated-work state
/.sites-runtime/
/.openai/
/.agents/
/.codex/
/outputs/
/work/
